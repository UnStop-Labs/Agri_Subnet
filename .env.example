# Bittensor wallet
WALLET_NAME=default
WALLET_HOTKEY=default
SUBTENSOR_NETWORK=finney        # finney | test | local
NETUID=1                         # your subnet UID

# Copernicus Data Space (free — https://dataspace.copernicus.eu)
COPERNICUS_USER=your@email.com
COPERNICUS_PASS=yourpassword

# Miner settings
MODEL_PATH=model/weights.pt
MODEL_VERSION=v1.1.0
DOCKER_IMAGE_REF=ghcr.io/yourorg/irrigation-miner:v1.1.0
GRID_RESOLUTION_M=20

# Validator settings
SYNTHETIC_BENCHMARK_PATH=validator/benchmarks/data/synthetic.json
CANARY_ROTATION_HOURS=24
MAX_RESPONSE_TIMEOUT_S=90
DOCKER_RERUN_ENABLED=true
